    {
      "title": "Create video",
      "source_url": "https://developers.openai.com/api/reference/resources/videos/methods/create",
      "endpoint": {
        "method": "POST",
        "uri": "/videos",
        "request_type": "application/json"
      },
      "description": "Create a new video generation job from a prompt and optional reference assets.",
      "parameters": {
        "body": []
      },
      "request_body_schema": [],
      "response_schema": [],
      "examples": [
        {
          "language": "http",
          "purpose": "request",
          "context": "Example",
          "code": "curl https://api.openai.com/v1/videos \\\n    -H 'Content-Type: application/json' \\\n    -H \"Authorization: Bearer $OPENAI_API_KEY\" \\\n    -d '{\n          \"prompt\": \"x\"\n        }'"
        },
        {
          "language": "json",
          "purpose": "response",
          "context": "Response",
          "code": "{\n  \"id\": \"id\",\n  \"completed_at\": 0,\n  \"created_at\": 0,\n  \"error\": {\n    \"code\": \"code\",\n    \"message\": \"message\"\n  },\n  \"expires_at\": 0,\n  \"model\": \"sora-2\",\n  \"object\": \"video\",\n  \"progress\": 0,\n  \"prompt\": \"prompt\",\n  \"remixed_from_video_id\": \"remixed_from_video_id\",\n  \"seconds\": \"string\",\n  \"size\": \"720x1280\",\n  \"status\": \"queued\"\n}"
        },
        {
          "language": "http",
          "purpose": "request",
          "context": "Example",
          "code": "curl https://api.openai.com/v1/videos \\\n  -H \"Authorization: Bearer $OPENAI_API_KEY\" \\\n  -F \"model=sora-2\" \\\n  -F \"prompt=A calico cat playing a piano on stage\""
