      "title": "Delete a fine-tuned model",
      "source_url": "https://developers.openai.com/api/reference/resources/models/methods/delete",
      "endpoint": {
        "method": "DELETE",
        "uri": "/models/{model}",
        "request_type": "application/json"
      },
      "description": "Delete a fine-tuned model. You must have the Owner role in your organization to delete a model.",
