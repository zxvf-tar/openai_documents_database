    {
      "title": "Add upload part",
      "source_url": "https://developers.openai.com/api/reference/resources/uploads/subresources/parts/methods/create",
      "endpoint": {
        "method": "POST",
        "uri": "/uploads/{upload_id}/parts",
        "request_type": "application/json"
      },
      "description": "Adds a [Part](/docs/api-reference/uploads/part-object) to an [Upload](/docs/api-reference/uploads/object) object. A Part represents a chunk of bytes from the file you are trying to upload. Each Part can be at most 64 MB, and you can add Parts until you hit the Upload maximum of 8 GB. It is possible to add multiple Parts in parallel. You can decide the intended order of the Parts when you [complete the Upload](/docs/api-reference/uploads/complete).",
      "parameters": {
        "path": []
      },
      "request_body_schema": [],
      "response_schema": [],
      "examples": [
        {
          "language": "http",
          "purpose": "request",
          "context": "Example",
          "code": "curl https://api.openai.com/v1/uploads/$UPLOAD_ID/parts \\\n    -H 'Content-Type: multipart/form-data' \\\n    -H \"Authorization: Bearer $OPENAI_API_KEY\" \\\n    -F 'data=@/path/to/data'"
        },
        {
          "language": "json",
          "purpose": "response",
          "context": "Response",
          "code": "{\n  \"id\": \"id\",\n  \"created_at\": 0,\n  \"object\": \"upload.part\",\n  \"upload_id\": \"upload_id\"\n}"
        },
        {
          "language": "http",
          "purpose": "request",
          "context": "Example",
          "code": "curl https://api.openai.com/v1/uploads/upload_abc123/parts\n  -F data=\"aHR0cHM6Ly9hcGkub3BlbmFpLmNvbS92MS91cGxvYWRz...\""
        },
        {
          "language": "json",
          "purpose": "response",
          "context": "Response",
          "code": "{\n  \"id\": \"part_def456\",\n  \"object\": \"upload.part\",\n  \"created_at\": 1719185911,\n  \"upload_id\": \"upload_abc123\"\n}"
        }
      ],
      "events_or_schemas": []
    }
