    {
      "title": "Upload file",
      "source_url": "https://developers.openai.com/api/reference/resources/files/methods/create",
      "endpoint": {
        "method": "POST",
        "uri": "/files",
        "request_type": "multipart/form-data"
      },
      "description": "Upload a file that can be used across various endpoints. Individual files can be up to 512 MB, and each project can store up to 2.5 TB of files in total. There is no organization-wide storage limit. Uploads to this endpoint are rate-limited to 1,000 requests per minute per authenticated user. file types. See the [Assistants Tools guide](/docs/assistants/tools) for details. certain required formats for fine-tuning [chat](/docs/api-reference/fine-tuning/chat-input) or [completions](/docs/api-reference/fine-tuning/completions-input) models. also has a specific required [format](/docs/api-reference/batch/request-input). you need to attach multiple uploaded files to the same vector store, use [`/vector_stores/{vector_store_id}/file_batches`](/docs/api-reference/vector-stores-file-batches/createBatch) instead of attaching them one by one. Vector store attachment has separate limits from file upload, including 2,000 attached files per minute per organization. Please [contact us](https://help.openai.com/) if you need to increase these storage limits.",
      "parameters": {},
      "request_body_schema": [],
      "response_schema": [],
      "examples": [
        {
          "language": "http",
          "purpose": "request",
          "context": "Example",
          "code": "curl https://api.openai.com/v1/files \\\n    -H 'Content-Type: multipart/form-data' \\\n    -H \"Authorization: Bearer $OPENAI_API_KEY\" \\\n    -F 'file=@/path/to/file' \\\n    -F purpose=assistants"
        },
        {
          "language": "json",
          "purpose": "response",
          "context": "Response",
          "code": "{\n  \"id\": \"id\",\n  \"bytes\": 0,\n  \"created_at\": 0,\n  \"filename\": \"filename\",\n  \"object\": \"file\",\n  \"purpose\": \"assistants\",\n  \"status\": \"uploaded\",\n  \"expires_at\": 0,\n  \"status_details\": \"status_details\"\n}"
        },
