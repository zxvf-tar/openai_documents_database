    {
      "title": "Create completion",
      "source_url": "https://developers.openai.com/api/reference/resources/completions/methods/create",
      "endpoint": {
        "method": "POST",
        "uri": "/completions",
        "request_type": "application/json"
      },
      "description": "Creates a completion for the provided prompt and parameters. Returns a completion object, or a sequence of completion objects if the request is streamed.",
      "parameters": {
        "body": []
      },
      "request_body_schema": [],
      "response_schema": [],
